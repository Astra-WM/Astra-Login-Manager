# Maintainer: Your Name <your-email@example.com>
pkgname=astra-login-manager
pkgver=1.0.0
pkgrel=1
pkgdesc="Quickshell-based, Rust-coded login manager"
arch=('x86_64' 'aarch64')
url="https://github.com/Astra-WM/Astra-Login-Manager"
license=('MIT')
depends=('quickshell' 'gcc-libs' 'glibc') 
makedepends=('cargo') 
source=("${pkgname}-${pkgver}.tar.gz::https://github.com{pkgver}.tar.gz")
sha256sums=('SKIP') # Run 'updpkgsums' to generate this

prepare() {
    cd "Astra-Login-Manager-${pkgver}"
    # Fetch Rust dependencies before building so it works in clean environments
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "Astra-Login-Manager-${pkgver}"
    # Compile the Rust binary in release mode
    CFLAGS+=' -ffat-lto-objects'
    cargo build --frozen --release
}

package() {
    cd "Astra-Login-Manager-${pkgver}"
    # Install the compiled binary to the system binary directory
    install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
    # Install the license file
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
